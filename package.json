{
  "name": "sheepcliff",
  "private": true,
  "version": "0.0.0",
  "description": "Sheepcliff: a cozy, watchable, pixel-art digital civilization.",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "npm run test --workspaces --if-present && node --test \"tools/ci/*.test.mjs\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "npm run e2e -w apps/web",
    "deploy": "tools/deploy/deploy.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
