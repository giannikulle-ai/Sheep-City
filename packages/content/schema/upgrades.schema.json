{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheepcliff.com/content/schema/upgrades.schema.json",
  "title": "Farm upgrades",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "source": { "$ref": "_defs.schema.json#/$defs/comment" },
    "comment": { "$ref": "_defs.schema.json#/$defs/comment" },
    "currency": { "type": "string", "enum": ["coins", "wool"] },
    "autoBuyInOrder": { "type": "boolean" },
    "upgrades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "_defs.schema.json#/$defs/id" },
          "cost": { "type": "integer", "minimum": 0 },
          "comment": { "$ref": "_defs.schema.json#/$defs/comment" }
        },
        "required": ["id", "cost", "comment"], "additionalProperties": false
      }
    }
  },
  "required": ["source", "currency", "autoBuyInOrder", "upgrades"],
  "additionalProperties": false
}
